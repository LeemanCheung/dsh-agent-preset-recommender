{
  "name": "dsh-agent-preset-recommender",
  "version": "0.1.3",
  "description": "Privacy-safe local activity scanner and agent preset recommender for DeepSeek Harness",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "npm test && npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "agent-preset",
    "codex",
    "claude-code",
    "workbuddy",
    "workflow",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeemanCheung/dsh-agent-preset-recommender.git"
  },
  "bugs": {
    "url": "https://github.com/LeemanCheung/dsh-agent-preset-recommender/issues"
  },
  "homepage": "https://github.com/LeemanCheung/dsh-agent-preset-recommender#readme",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
